# Copy to .env (mode 600). Never commit .env. Server values live in /home/genslr/dhaka-crime-map/.env
POSTGRES_PASSWORD=change-me-long-random
ADMIN_TOKEN=change-me-long-random          # review API + token-triggered runs (X-Admin-Token)

# Server only (compose.inhouse.yaml)
API_BIND=192.168.1.200                     # LAN address the HTTPS API listens on
HOST_UID=1000
HOST_GID=1000

# Classifier
CLASSIFIER=gemma                           # gemma (local llama.cpp/vLLM) | claude | rules
GEMMA_API_KEY=                             # = contents of ~/.config/dhaka-llm/api-key on the server
GEMMA_MODEL=dhaka-gemma
GEMMA_PROMPT=compact                       # compact (place shortlist) | full (163-place catalogue)
PUBLISH_MODE=review                        # review: humans approve | auto: publish when checks pass
CLASSIFY_CONCURRENCY=1
MAX_LLM_CALLS_PER_DAY=200                  # paid backends only (claude)
ANTHROPIC_API_KEY=                         # only if CLASSIFIER=claude

# Collection
SCRAPE_TIMES=08:00,20:00                   # Asia/Dhaka
USER_AGENT=DhakaCrimeMap/0.2 (+https://github.com/zawadgenweb2/dhaka-crime-map)
MAX_ARTICLES_PER_RUN=150
ALLOW_UI_TRIGGER=true                      # dashboard "Collect now" (same-origin); set false before going public

# Geocoding and map
GEOCODE_ENABLED=true
GEOCODE_MIN_INTERVAL_SECONDS=15            # Nominatim policy for scheduled scripts: max 4/min
GOOGLE_MAPS_API_KEY=                       # browser key, referrer-restricted; empty = OpenStreetMap tiles
GOOGLE_MAPS_MAP_ID=

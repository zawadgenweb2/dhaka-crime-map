# Copy to .env (mode 600). Never commit .env. On the in-house server it is ~/dhaka-crime-map/.env
POSTGRES_PASSWORD=change-me-long-random
ADMIN_TOKEN=change-me-long-random          # machine token for scripts on the admin panel (X-Admin-Token); people log in
ADMIN_PASSWORD_MIN=12                     # minimum admin password length
                                           # with accounts: python -m app admin-user add <name>

# Server only (compose.inhouse.yaml)
API_BIND=192.168.1.200                     # LAN address the HTTPS API listens on
HOST_UID=1000
HOST_GID=1000

# Classifier
CLASSIFIER=gemma                           # gemma (in-house llama.cpp/vLLM server) | rules (offline)
GEMMA_API_KEY=                             # = contents of ~/.config/dhaka-llm/api-key on the server
GEMMA_MODEL=dhaka-gemma
GEMMA_PROMPT=compact                       # compact (place shortlist) | full (163-place catalogue)
PUBLISH_MODE=auto                          # auto: publish when the automatic checks pass | review: humans approve first
CLASSIFY_CONCURRENCY=2                     # parallel Gemma requests; the model server has 3 slots (one for the event matcher)

# Collection
SCRAPE_TIMES=08:00,20:00                   # Asia/Dhaka
USER_AGENT=DhakaCrimeMap/0.2 (+https://github.com/zawadgenweb2/dhaka-crime-map)
MAX_ARTICLES_PER_RUN=150
ADMIN_BIND=192.168.1.200                   # address of the admin panel (port 8101): office LAN / VPN only, never public

# Geocoding and map
GEOCODE_ENABLED=true
GEOCODE_MIN_INTERVAL_SECONDS=15            # Nominatim policy for scheduled scripts: max 4/min
GOOGLE_MAPS_API_KEY=                       # browser key, referrer-restricted; empty = OpenStreetMap tiles
GOOGLE_MAPS_MAP_ID=

# Event matcher (cross-paper duplicates): EmbeddingGemma server on the host
EMBED_URL=http://127.0.0.1:8091/v1/embeddings

# Build identity (CI sets it; /api/health shows it as "version")
GIT_SHA=dev

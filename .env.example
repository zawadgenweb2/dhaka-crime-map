# Copy to .env and fill in. .env is private; never commit it.

# --- Classifier ---------------------------------------------------------------
# claude = prototype (Claude Opus 5.5 via API)
# gemma  = future local model (Gemma 4 E2B via Ollama / vLLM, runs on CPU)
# rules  = keyword baseline, offline, no cost
CLASSIFIER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (medium is a good balance for this task)
CLAUDE_EFFORT=medium
CLASSIFY_WORKERS=3

GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=gemma4:e2b

# --- Schedule (Asia/Dhaka wall clock) ------------------------------------------
SCHEDULER_ENABLED=true
SCRAPE_TIMES=08:00,20:00

# --- Scraping -----------------------------------------------------------------
USER_AGENT=DhakaCrimeMap/0.1 (research prototype; contact: you@example.com)
REQUEST_DELAY_SECONDS=1.0
MAX_ARTICLES_PER_RUN=150
# Look up exact spots (streets, stations, markets) on OpenStreetMap
GEOCODE_ENABLED=true

# --- Map ----------------------------------------------------------------------
# Browser key with "Maps JavaScript API" enabled. Restrict it to your site
# (HTTP referrer http://localhost:8100/*). Empty = OpenStreetMap fallback map.
GOOGLE_MAPS_API_KEY=
# Optional vector Map ID (Google Cloud > Map Management). Enables cloud styling.
GOOGLE_MAPS_MAP_ID=

# --- Server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8100
DATABASE_PATH=data/crime.db
# Needed to trigger runs from another machine (header X-Admin-Token). Empty = localhost only.
ADMIN_TOKEN=

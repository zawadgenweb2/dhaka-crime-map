# Secrets (API keys) - only .env.example is committed
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Runtime data: the SQLite database holds scraped article text
data/*.db
data/*.db-*
data/*.sqlite*
*.log

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
deploy/tls/

# Database dumps and evaluation output contain real data: never commit them
*.dump
data/eval/

# Keep local Markdown notes and documentation out of the repository.
*.md

# The architecture guide is the one tracked Markdown document.
!docs/microservices-architecture.md

# Keep the printable local copy of the guide out of Git.
/docs/microservices-architecture.html

# Keep generated PDF reports local.
*.pdf

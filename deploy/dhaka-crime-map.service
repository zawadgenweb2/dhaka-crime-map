# systemd user service: dashboard + API + 08:00/20:00 scheduler.
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/dhaka-crime-map.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now dhaka-crime-map
#   loginctl enable-linger "$USER"     # keep running when logged out
[Unit]
Description=Dhaka Crime Map (Prothom Alo -> Claude -> heat map)
After=network-online.target

[Service]
WorkingDirectory=%h/crime-heat-map/dhaka-crime-map
ExecStart=%h/crime-heat-map/dhaka-crime-map/.venv/bin/python -m app serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
